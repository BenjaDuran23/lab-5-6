<%= render 'layouts/navegation' %>

<div class="container">
  <h1 class="mb-4">Users</h1>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>E-mail</th>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Created At</th>
          <th>Updated At</th>
          <th>Total Messages</th>
          <th>Show Info</th>
        </tr>
      </thead>

      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.email %></td>
            <td><%= user.first_name %></td>
            <td><%= user.last_name %></td>
            <td><%= user.created_at.strftime("%Y-%m-%d") %></td>
            <td><%= user.updated_at.strftime("%Y-%m-%d") %></td>
            <td><%= user.messages.count %></td>

            <td><%= link_to 'Show Info', user_path(user), class: 'btn btn-outline-info btn-sm' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
