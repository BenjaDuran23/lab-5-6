<%= render 'layouts/navegation' %>

<div class="container py-4">
  <div class="row">
    <div class="col-md-6 mb-4">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><%= @user.first_name %> <%= @user.last_name %></h4>
        </div>
        <div class="card-body">
          <p><strong>E-mail:</strong> <%= @user.email %></p>
          <p><strong>Created at:</strong> <%= @user.created_at.strftime("%Y-%m-%d %H:%M") %></p>
          <p><strong>Updated at:</strong> <%= @user.updated_at.strftime("%Y-%m-%d %H:%M") %></p>
            <div class="mt-3">
            <% if can?(:edit, @user) %>
              <%= link_to 'Edit', edit_user_path(@user), class: 'btn btn-outline-warning btn-sm' %>
            <% end %>
            <% if can?(:destroy, @user) %>
              <td><%= link_to 'Delete', user_path(@user), data: { turbo_method: :delete, turbo_confirm: "Are you sure about that?"}, class: "btn btn-sm btn-danger" %></td>
            <% end %>
            </div>
        </div>
      </div>
    </div>

 <% if @chat_ids.any? %>
    <% @chats.each do |chat| %>
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span>Chat ID: <%= chat.id %></span>
          <%= link_to 'Continue Chat', chat_path(chat), class: 'btn btn-sm btn-outline-primary' %>
        </div>
        <div class="card-body" style="max-height: 300px; overflow-y: auto;">
          <% chat.messages.order(:created_at).each do |message| %>
            <div class="mb-2">
              <strong><%= message.user == current_user ? "You" : message.user.first_name %>:</strong>
              <span><%= message.body %></span>
              <br>
              <small class="text-muted"><%= message.created_at.strftime("%b %d, %Y %H:%M") %></small>
            </div>
            <hr>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>


  <%= link_to "Go back to all listed users", users_path, class: 'btn btn-outline-primary' %>
</div>
