<%= render 'layouts/navegation' %>
<div class="container d-flex justify-content-center align-items-center min-vh-100">
  <div class="col-md-6">
    

    <div class="card shadow-lg rounded-4 p-4">
      <h2 class="mb-4 text-center">Log in</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="mb-3">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", required: true, placeholder: "E-mail" %>
          <div class="invalid-feedback">
            Please enter your email.
          </div>
        </div>

        <div class="mb-3">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control", required: true, placeholder: "password" %>
          <div class="invalid-feedback">
            Please enter your password.
          </div>
        </div>

        <%= f.submit "Log in", class: "btn btn-primary w-100" %>
      <% end %>

      <div class="mt-3 text-center">
        <% if devise_mapping.registerable? && controller_name != 'registrations' %>
          <%= link_to "Don't have an account? Sign up", new_registration_path(resource_name), class: "btn btn-text" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
