<%= render 'layouts/navegation' %>

<div class="container my-4">
  <h1 class="mb-4">Edit Message</h1>

  <%= form_with model: @message do |form| %>
    <div class="mb-3">
      <%= form.label :body, "Message Text", class: "form-label" %>
      <%= form.text_area :body, class: "form-control", rows: 5, placeholder: "Edit your message here..." %>
    </div>

    <div class="d-flex align-items-center">
      <%= form.submit "Update Message", class: "btn btn-primary" %>
      <%= link_to "Cancel", chat_path(@message.chat_id), class: "btn btn-outline-secondary ms-3" %>
    </div>
  <% end %>
</div>
