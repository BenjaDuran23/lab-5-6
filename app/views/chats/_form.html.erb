<%= form_with model: @chat do |f| %>
  <div class="mb-3">
    <%= f.label :receiver_id, "Select User to Chat With", class: "form-label" %>
    <%= f.collection_select :receiver_id, User.where.not(id: current_user.id), :id, :first_name, { prompt: "Choose a user" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.submit "Start Chat", class: "btn btn-primary" %>
    <%= link_to "Back to Chats", chats_path, class: "btn btn-secondary ms-2" %>
  </div>
<% end %>