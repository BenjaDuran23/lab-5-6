<%= render 'layouts/navegation' %>

<div class="container my-4">
  <h1 class="mb-4">My Chats</h1>

  <div class="container text-center">
    <%= link_to 'Chat With Your Contacts!', new_chat_path, class: 'btn btn-success mb-3' %>
  </div>

  <% if @chats.any? %>
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>Chat ID</th>
          <th>Receiver</th>
          <th>Created At</th>
          <th>Updated At</th>
          <th>Chat Actions</th>
        </tr>
      </thead>

      <tbody>
        <% @chats.each do |chat| %>
          <tr>
            <td><%= chat.id %></td>
            <td><%= chat.receiver.first_name %></td>
            <td><%= chat.created_at.strftime("%d %b %Y, %H:%M") %></td>
            <td><%= chat.updated_at.strftime("%d %b %Y, %H:%M") %></td>
            <td>
              <%= link_to 'Continue To Chat', chat_path(chat), class: 'btn btn-outline-primary btn-sm me-2' %>

              <% if [chat.sender_id, chat.receiver_id].include?(current_user.id) %>
                <%= link_to 'Delete This Conversation', chat_path(chat), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this conversation?"}, class: 'btn btn-outline-danger btn-sm' %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-muted">You don't have any chats yet.</p>
  <% end %>
</div>
